// =============================================================================
// app.slint: rust-xterm Slint Demo 的 UI 定义
// =============================================================================
// 布局：
//   Window
//     └─ VerticalLayout
//          ├─ Rectangle (终端显示区，含 Image + TouchArea)
//          └─ Rectangle (底部状态栏：FPS / 内存 / 滚动信息)
//
// 键盘：Window.forward-focus → FocusScope，key-pressed 回调上报到 Rust
// 鼠标：TouchArea.pointer-event 回调上报 (x, y, kind, button) 到 Rust
// =============================================================================

export component App inherits Window {
    title: "rust-xterm Slint Demo";
    preferred-width: 800px;
    preferred-height: 600px;
    background: #000000;

    // ---- Rust ↔ Slint 属性 ----
    in-out property <image> terminal-image;
    in-out property <string> fps-text: "FPS: --";
    in-out property <string> mem-text: "Mem: -- MB";
    in-out property <string> scroll-text: "Scroll: 0";

    // ---- Rust ↔ Slint 回调 ----
    // 键盘：text + 三个修饰键布尔值
    callback key-pressed-cb(string, bool, bool, bool);
    // 鼠标：x, y, kind(0=down/1=up/2=move/3=exit), button(0=none/1=left/2=right/3=middle)
    callback pointer-event-cb(float, float, int, int);
    // 滚轮：delta-y（正值向上滚，负值向下滚，单位 px）
    callback scroll-cb(float);

    // 将窗口焦点转发到 FocusScope
    forward-focus: key-handler;

    VerticalLayout {
        spacing: 0px;

        // ---- 终端显示区 ----
        Rectangle {
            vertical-stretch: 1;
            background: #000000;

            img := Image {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                source: terminal-image;
                image-fit: fill;
            }

            touch := TouchArea {
                width: 100%;
                height: 100%;

                pointer-event(e) => {
                    pointer-event-cb(
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                        kind-to-int(e.kind),
                        button-to-int(e.button)
                    );
                }

                scroll-event(e) => {
                    scroll-cb(e.delta-y / 1px);
                    accept
                }
            }
        }

        // ---- 底部状态栏 ----
        Rectangle {
            height: 22px;
            background: #1a1a1a;

            HorizontalLayout {
                padding: 4px;
                spacing: 16px;

                Text {
                    text: fps-text;
                    color: #00ff00;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: mem-text;
                    color: #00ffff;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: scroll-text;
                    color: #ffffaa;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- 键盘焦点作用域 ----
    key-handler := FocusScope {
        key-pressed(event) => {
            key-pressed-cb(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift
            );
            accept
        }
    }

    // ---- 枚举转整数（供回调参数使用） ----
    function kind-to-int(k: PointerEventKind) -> int {
        if (k == PointerEventKind.down) { 0 }
        else if (k == PointerEventKind.up) { 1 }
        else if (k == PointerEventKind.move) { 2 }
        else { 3 }
    }

    function button-to-int(b: PointerEventButton) -> int {
        if (b == PointerEventButton.left) { 1 }
        else if (b == PointerEventButton.right) { 2 }
        else if (b == PointerEventButton.middle) { 3 }
        else { 0 }
    }
}
