// =============================================================================
// app.slint: russh-slint-demo 的 UI 定义
// =============================================================================
// 布局：
//   Window
//     └─ VerticalLayout
//          ├─ 终端显示区（Rectangle + Image + TouchArea）
//          └─ 底部状态栏（SSH / FPS / 内存 / 滚动）
//     └─ 遮罩层（条件渲染：connecting=true 时全屏覆盖）
//     └─ FocusScope（键盘事件）
// =============================================================================

export component App inherits Window {
    title: "rust-xterm russh SSH Demo";
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 400px;
    min-height: 300px;
    background: #000000;

    // ---- Rust ↔ Slint 属性 ----
    in-out property <image> terminal-image;
    in-out property <string> fps-text: "FPS: --";
    in-out property <string> mem-text: "Mem: -- MB";
    in-out property <string> scroll-text: "Scroll: 0";
    in-out property <string> ssh-text: "SSH: idle";
    // 滚动条状态：scroll-offset = 当前偏移（0 = 最新），scroll-max = 最大 scrollback
    in-out property <int> scroll-offset: 0;
    in-out property <int> scroll-max: 0;

    // 连接状态机
    //   connecting=true  → 显示遮罩，遮罩文字 = status-text
    //   connecting=false → 隐藏遮罩，显示终端
    in-out property <bool> connecting: true;
    in-out property <string> status-text: "初始化中...";
    // 错误状态：连接失败时设为非空字符串，遮罩显示红色错误信息
    in-out property <string> error-text: "";

    // ---- Rust ↔ Slint 回调 ----
    callback key-pressed-cb(string, bool, bool, bool);
    callback pointer-event-cb(float, float, int, int);
    callback scroll-cb(float);
    // ScrollBar 拖拽/点击 → 通知 Rust 更新 scroll_offset（Slint 1.6 无 on_property_changed，用自定义回调替代）
    callback scroll-to(float);

    forward-focus: key-handler;

    VerticalLayout {
        spacing: 0px;

        // ---- 终端显示区（始终存在，但被遮罩覆盖时不可见） ----
        Rectangle {
            vertical-stretch: 1;
            background: #000000;

            img := Image {
                x: 0px;
                y: 0px;
                width: parent.width - 12px;
                height: 100%;
                source: terminal-image;
                image-fit: contain;
            }

            touch := TouchArea {
                width: 100%;
                height: 100%;

                pointer-event(e) => {
                    pointer-event-cb(
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                        kind-to-int(e.kind),
                        button-to-int(e.button)
                    );
                }

                scroll-event(e) => {
                    scroll-cb(e.delta-y / 1px);
                    accept
                }
            }

            // ---- 右侧垂直滚动条（手动实现，Slint 1.6 无内置 ScrollBar） ----
            Rectangle {
                x: parent.width - 12px;
                y: 0px;
                width: 12px;
                height: 100%;
                background: #1a1a1a;

                // 拖拽/点击区域：覆盖整个滚动条宽度（12px），便于点击
                bar-touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(e) => {
                        // 按下或拖动时：根据鼠标 Y 位置计算新 offset 并通知 Rust
                        if (e.kind == PointerEventKind.down
                             || (e.kind == PointerEventKind.move && self.pressed)) {
                            if (scroll-max > 0) {
                                // mouse-y ∈ [0, parent.height] → ratio ∈ [0, 1]
                                // scroll-offset = 0 表示最新（底部），scroll-max 表示最旧（顶部）
                                // 故 offset = scroll-max * (1 - ratio)
                                scroll-to(scroll-max * (1.0 - (self.mouse-y / 1px) / (parent.height / 1px)))
                            }
                        }
                    }
                }

                // track
                Rectangle {
                    x: 4px;
                    y: 0px;
                    width: 4px;
                    height: 100%;
                    background: #2a2a2a;
                    border-radius: 2px;

                    // thumb
                    thumb := Rectangle {
                        x: 0px;
                        width: 100%;
                        height: scroll-max > 0
                            ? max(parent.height * 0.1, 20px)
                            : 0px;
                        y: scroll-max > 0
                            ? (parent.height - self.height) * (1.0 - scroll-offset * 1.0 / max(scroll-max, 1))
                            : 0px;
                        background: #6a6a6a;
                        border-radius: 2px;
                    }
                }
            }
        }

        // ---- 底部状态栏 ----
        Rectangle {
            height: 22px;
            background: #1a1a1a;

            HorizontalLayout {
                padding: 4px;
                spacing: 12px;

                Text {
                    text: ssh-text;
                    color: #88aaff;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: fps-text;
                    color: #00ff00;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: mem-text;
                    color: #00ffff;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: scroll-text;
                    color: #ffffaa;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- 连接遮罩（条件渲染：覆盖整个窗口，包括状态栏） ----
    // 当 connecting=true 时显示：半透明黑色背景 + 居中进度文字 + 错误信息
    if connecting : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 220);

        VerticalLayout {
            alignment: center;

            Text {
                text: "rust-xterm russh SSH";
                color: #ffffff;
                font-size: 22px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: status-text;
                color: #88aaff;
                font-size: 14px;
                horizontal-alignment: center;
            }

            Text {
                text: error-text;
                color: #ff5555;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // ---- 键盘焦点作用域 ----
    key-handler := FocusScope {
        key-pressed(event) => {
            key-pressed-cb(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift
            );
            accept
        }
    }

    // ---- 枚举转整数（供回调参数使用） ----
    function kind-to-int(k: PointerEventKind) -> int {
        if (k == PointerEventKind.down) { 0 }
        else if (k == PointerEventKind.up) { 1 }
        else if (k == PointerEventKind.move) { 2 }
        else { 3 }
    }

    function button-to-int(b: PointerEventButton) -> int {
        if (b == PointerEventButton.left) { 1 }
        else if (b == PointerEventButton.right) { 2 }
        else if (b == PointerEventButton.middle) { 3 }
        else { 0 }
    }
}
